# =============================================================================
# Morada do Japu — variáveis de ambiente
#
# Copie para .env e preencha. NUNCA comite o .env: ele está no .gitignore.
# Em produção o servidor se recusa a subir sem SESSION_SECRET.
# =============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Origem pública do site. Usada em cookies, CORS e no retorno do gateway.
PUBLIC_ORIGIN=http://localhost:3000

# Assina o cookie de sessão e o token anti-CSRF. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Marque true SOMENTE se houver proxy reverso (nginx, Cloudflare) na frente.
# Com true e sem proxy, qualquer visitante forja o próprio IP e derruba o
# rate limiting de todo mundo.
TRUST_PROXY=false

# --- Limites de requisição (por janela) --------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_CHECKOUT_MAX=8

# --- Envio --------------------------------------------------------------------
SHIPPING_ORIGIN_CEP=45650000
SHIPPING_FREE_ABOVE_CENTS=25000

# --- Limites de sanidade do pedido --------------------------------------------
ORDER_MAX_LINE_QTY=20
ORDER_MAX_LINES=30
ORDER_MAX_TOTAL_CENTS=500000

# =============================================================================
# PAGAMENTO — desligado por padrão
#
# Com PAYMENT_PROVIDER=none a loja registra o pedido e manda finalizar pelo
# WhatsApp. Para ligar de verdade, veja docs/PAGAMENTO.md antes de preencher.
#
# PAYMENT_PUBLIC_KEY é o único valor daqui que chega ao navegador.
# PAYMENT_SECRET_KEY e PAYMENT_WEBHOOK_SECRET jamais saem do servidor.
# =============================================================================
PAYMENT_PROVIDER=none
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
